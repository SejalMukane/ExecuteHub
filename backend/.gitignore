# See https://help.github.com/articles/ignoring-files for more about ignoring files.

# Ignore bundler config.
/.bundle

# Ignore all environment files.
/.env*

# Ignore all logfiles and tempfiles.
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep

# Ignore pidfiles, but keep the directory.
/tmp/pids/*
!/tmp/pids/.keep

# Ignore storage (uploaded files in development should stay out of git).
/storage/*
!/storage/.keep

# Ignore master key for decrypting credentials and more.
/config/master.key

# Ignore vendor/bundle if using deployment mode.
/vendor/bundle

# Ignore Ruby mine / IDE files.
/.idea
/.vscode

# Ignore bootsnap compile cache.
/tmp/cache/*

# Ignore coverage reports.
/coverage

# Ignore database files.
/db/*.sqlite3
/db/*.sqlite3-*

# Ignore Byebug command history file.
.byebug_history

# Ignore node_modules if frontend is mixed in.
/node_modules
